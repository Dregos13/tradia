{
  "$schema": "https://tradia.local/schemas/design-tokens.v1.json",
  "meta": {
    "name": "Tradia — Telemetría de box · Tour guiado, conexión y frescura de datos",
    "version": "7.0.0",
    "extends": ["./base.tokens.json", "./market.tokens.json"],
    "contrastStandard": "WCAG 2.2 AA",
    "baseUnit": "4px",
    "note": "No introduce colores nuevos: cada valor procede de base.tokens.json (color.light/dark y color.state) o de market.tokens.json (color.dataStatus). Los velos son la tinta base con transparencia. Los contrastes están calculados con la fórmula de luminancia relativa de WCAG 2.2."
  },
  "color": {
    "tour": {
      "scrim": {
        "light": "rgba(10, 14, 18, 0.55)",
        "dark": "rgba(10, 14, 18, 0.72)",
        "name": "Velo del tour",
        "source": "base.color.light.text / base.color.dark.canvas con alfa",
        "compositeLight": "#738392",
        "compositeDark": "#07090C"
      },
      "spotlightRing": {
        "light": "#4A6500",
        "dark": "#C6F432",
        "name": "Anillo del elemento resaltado",
        "source": "base.color.*.focus",
        "width": "3px",
        "offset": "4px",
        "contrastLightOnSurface": "5.40:1",
        "contrastDarkOnSurface": "8.45:1",
        "contrastDarkOnScrim": "10.00:1"
      },
      "spotlightHalo": {
        "light": "#FFFFFF",
        "dark": "#10161C",
        "name": "Halo exterior del anillo",
        "source": "base.color.*.surface",
        "width": "2px",
        "contrastLightOnScrim": "3.89:1",
        "why": "En claro el anillo de foco sobre el velo solo da 1.39:1; el halo de superficie separa el resaltado del velo con 3.89:1 (no textual, mínimo 3:1)."
      },
      "popover": {
        "light": "#FFFFFF",
        "dark": "#10161C",
        "border": {
          "light": "#738392",
          "dark": "#66747F"
        },
        "title": {
          "light": "#0C1218",
          "dark": "#E4EAF0",
          "contrastLight": "15.55:1",
          "contrastDark": "15.15:1"
        },
        "body": {
          "light": "#475563",
          "dark": "#9AA8B6",
          "contrastLight": "6.20:1",
          "contrastDark": "9.10:1"
        },
        "name": "Globo del paso",
        "borderContrastLight": "3.03:1",
        "borderContrastDark": "4.12:1"
      },
      "progressDone": {
        "light": "#0A6390",
        "dark": "#C6F432",
        "name": "Segmento de progreso hecho",
        "source": "base.color.*.accent",
        "contrastLightOnSurface": "7.63:1",
        "contrastDarkOnSurface": "6.69:1"
      },
      "progressPending": {
        "light": "#738392",
        "dark": "#66747F",
        "name": "Segmento de progreso pendiente",
        "source": "base.color.*.borderStrong",
        "contrastLightOnSurface": "3.03:1",
        "contrastDarkOnSurface": "4.12:1",
        "note": "Decorativo (aria-hidden). El progreso se escribe siempre: «Paso 3 de 10»."
      },
      "stepLabel": {
        "light": "#4A6500",
        "dark": "#C6F432",
        "surfaceLight": "#DDEFF8",
        "surfaceDark": "#0E2431",
        "name": "Etiqueta «Paso n de 10»",
        "contrastLight": "6.47:1",
        "contrastDark": "5.62:1"
      }
    },
    "firstSteps": {
      "done": {
        "light": "#0B7548",
        "lightSurface": "#DCF2E7",
        "dark": "#3CCB8A",
        "darkSurface": "#0E271D",
        "label": "Hecho",
        "icon": "circle-check",
        "contrastLight": "4.90:1",
        "contrastDark": "7.61:1",
        "source": "base.color.state.success"
      },
      "pending": {
        "light": "#475563",
        "lightSurface": "#E7ECF0",
        "dark": "#9AA8B6",
        "darkSurface": "#1C252E",
        "label": "Pendiente",
        "icon": "circle-dashed",
        "contrastLight": "6.43:1",
        "contrastDark": "6.39:1",
        "source": "live.color.requirement.locked"
      },
      "attention": {
        "light": "#7A5900",
        "lightSurface": "#F5ECCB",
        "dark": "#EBC05A",
        "darkSurface": "#2E2610",
        "label": "Revisar",
        "icon": "triangle-alert",
        "contrastLight": "5.45:1",
        "contrastDark": "8.72:1",
        "source": "market.color.dataStatus.stale"
      }
    },
    "connection": {
      "idle": {
        "light": "#475563",
        "lightSurface": "#E7ECF0",
        "dark": "#9AA8B6",
        "darkSurface": "#1C252E",
        "label": "Sin probar",
        "icon": "plug",
        "contrastLight": "6.43:1",
        "contrastDark": "6.39:1"
      },
      "testing": {
        "light": "#0A6390",
        "lightSurface": "#DDEFF8",
        "dark": "#6CC6F2",
        "darkSurface": "#0E2431",
        "label": "Probando",
        "icon": "loader",
        "contrastLight": "5.55:1",
        "contrastDark": "8.36:1",
        "source": "market.color.dataStatus.updating"
      },
      "ok": {
        "light": "#0B7548",
        "lightSurface": "#DCF2E7",
        "dark": "#3CCB8A",
        "darkSurface": "#0E271D",
        "label": "Conectado",
        "icon": "circle-check",
        "contrastLight": "4.90:1",
        "contrastDark": "7.61:1",
        "source": "market.color.dataStatus.reliable"
      },
      "missingKey": {
        "light": "#7A5900",
        "lightSurface": "#F5ECCB",
        "dark": "#EBC05A",
        "darkSurface": "#2E2610",
        "label": "Sin clave",
        "icon": "key-round",
        "contrastLight": "5.45:1",
        "contrastDark": "8.72:1",
        "source": "market.color.dataStatus.stale"
      },
      "rejectedKey": {
        "light": "#B0202E",
        "lightSurface": "#FBE3E5",
        "dark": "#FF7D87",
        "darkSurface": "#3A1519",
        "label": "Clave rechazada",
        "icon": "key-round-x",
        "contrastLight": "5.57:1",
        "contrastDark": "6.56:1",
        "source": "base.color.state.critical"
      },
      "quota": {
        "light": "#7F5E00",
        "lightSurface": "#FFF2BF",
        "dark": "#FFD23F",
        "darkSurface": "#302709",
        "label": "Cuota agotada",
        "icon": "gauge",
        "contrastLight": "5.34:1",
        "contrastDark": "10.24:1",
        "source": "base.color.state.alert"
      },
      "offline": {
        "light": "#A3460E",
        "lightSurface": "#FBE6D8",
        "dark": "#FF9A5C",
        "darkSurface": "#33200F",
        "label": "Sin red",
        "icon": "wifi-off",
        "contrastLight": "5.06:1",
        "contrastDark": "7.41:1",
        "source": "base.color.state.offline"
      },
      "error": {
        "light": "#B0202E",
        "lightSurface": "#FBE3E5",
        "dark": "#FF7D87",
        "darkSurface": "#3A1519",
        "label": "Error del proveedor",
        "icon": "circle-alert",
        "contrastLight": "5.57:1",
        "contrastDark": "6.56:1",
        "source": "base.color.state.critical"
      }
    },
    "freshness": {
      "current": {
        "light": "#0B7548",
        "lightSurface": "#DCF2E7",
        "dark": "#3CCB8A",
        "darkSurface": "#0E271D",
        "label": "Al día",
        "icon": "check-circle",
        "contrastLight": "4.90:1",
        "contrastDark": "7.61:1",
        "source": "market.color.dataStatus.reliable"
      },
      "catchingUp": {
        "light": "#0A6390",
        "lightSurface": "#DDEFF8",
        "dark": "#6CC6F2",
        "darkSurface": "#0E2431",
        "label": "Poniéndose al día",
        "icon": "progress-ring",
        "contrastLight": "5.55:1",
        "contrastDark": "8.36:1",
        "source": "market.color.dataStatus.updating"
      },
      "stale": {
        "light": "#7A5900",
        "lightSurface": "#F5ECCB",
        "dark": "#EBC05A",
        "darkSurface": "#2E2610",
        "label": "Datos desactualizados",
        "icon": "clock",
        "contrastLight": "5.45:1",
        "contrastDark": "8.72:1",
        "textOnSurfaceLight": "13.03:1",
        "textOnSurfaceDark": "11.52:1",
        "focusOnSurfaceLight": "4.52:1",
        "focusOnSurfaceDark": "6.42:1",
        "source": "market.color.dataStatus.stale"
      },
      "unreliable": {
        "light": "#B0202E",
        "lightSurface": "#FBE3E5",
        "dark": "#FF7D87",
        "darkSurface": "#3A1519",
        "label": "Datos no fiables",
        "icon": "diamond-alert",
        "contrastLight": "5.57:1",
        "contrastDark": "6.56:1",
        "textOnSurfaceLight": "12.97:1",
        "textOnSurfaceDark": "12.89:1",
        "focusOnSurfaceLight": "4.50:1",
        "focusOnSurfaceDark": "7.19:1",
        "source": "market.color.dataStatus.unreliable"
      },
      "noData": {
        "light": "#475563",
        "lightSurface": "#E7ECF0",
        "dark": "#9AA8B6",
        "darkSurface": "#1C252E",
        "label": "Sin datos",
        "icon": "database",
        "contrastLight": "6.43:1",
        "contrastDark": "6.39:1"
      },
      "offline": {
        "light": "#A3460E",
        "lightSurface": "#FBE6D8",
        "dark": "#FF9A5C",
        "darkSurface": "#33200F",
        "label": "Sin conexión",
        "icon": "wifi-off",
        "contrastLight": "5.06:1",
        "contrastDark": "7.41:1",
        "source": "base.color.state.offline"
      }
    }
  },
  "spacing": {
    "0": "0",
    "1": "4px",
    "2": "8px",
    "3": "12px",
    "4": "16px",
    "5": "20px",
    "6": "24px",
    "8": "32px",
    "10": "40px"
  },
  "radius": {
    "spotlight": "12px",
    "popover": "16px",
    "chip": "999px",
    "card": "16px"
  },
  "shadow": {
    "popover": {
      "value": "0 18px 48px rgba(8, 18, 35, 0.18)",
      "name": "Flotante",
      "source": "base.shadow.floating"
    }
  },
  "size": {
    "controlMin": "44px",
    "popoverWidth": "360px",
    "popoverMaxWidth": "calc(100vw - 40px)",
    "popoverOffset": "16px",
    "viewportMargin": "20px",
    "progressSegment": "20px",
    "progressSegmentHeight": "4px",
    "freshnessChipMin": "32px",
    "bottomSheetBreakpoint": "760px"
  },
  "zIndex": {
    "scrim": 900,
    "spotlight": 901,
    "popover": 902,
    "note": "Por encima de la franja DINERO REAL y de los banners; por debajo de nada. El diálogo de reanudación de la parada nunca coincide con el tour (el tour no arranca si hay un diálogo abierto)."
  },
  "motion": {
    "spotlightMove": "200ms",
    "popoverEnter": "120ms",
    "easeOut": "cubic-bezier(0.2, 0.9, 0.1, 1)",
    "reduced": "0ms",
    "scrollBehavior": "smooth",
    "scrollBehaviorReduced": "auto",
    "spinnerReduced": "Sin giro: el icono queda fijo y el texto «Probando…» o «Poniéndose al día…» lleva el estado."
  }
}
