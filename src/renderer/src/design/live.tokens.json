    "floating": {
      "value": "0 16px 40px rgba(3, 5, 8, 0.32)",
      "name": "Flotante (diálogos)"
    }
  },
  "size": {
    "controlMin": "44px",
    "sidebar": "228px",
    "contentMax": "1120px",
    "statusBar": "48px",
    "liveBannerMin": "48px",
    "checklistLabel": "260px",
    "limitsPanelMin": "320px",
    "shortRequirementLabel": "176px",
    "dialogMax": "620px",
    "smokeTimelineRail": "2px"
