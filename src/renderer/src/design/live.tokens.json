      "interface": {
        "value": "Sora, ui-sans-serif, -apple-system, BlinkMacSystemFont, 'Segoe UI', sans-serif",
        "name": "Interfaz · Sora"
      },
      "editorial": {
        "value": "Sora, ui-sans-serif, -apple-system, BlinkMacSystemFont, 'Segoe UI', sans-serif",
        "name": "Titulares · Sora"
      },
      "numeric": {
        "value": "'IBM Plex Mono', ui-monospace, SFMono-Regular, Consolas, 'Liberation Mono', monospace",
        "name": "Datos · IBM Plex Mono"
      }
    },
    "numeric": {
      "fontVariantNumeric": "tabular-nums",
      "slashedZero": true
    },
    "size": {
      "xs": {
        "value": "13px",
        "lineHeight": "18px"
      },
      "sm": {
        "value": "14px",
        "lineHeight": "21px"
      },
      "md": {
        "value": "16px",
        "lineHeight": "24px"
      },
      "lg": {
        "value": "18px",
        "lineHeight": "26px"
      },
      "xl": {
        "value": "24px",
        "lineHeight": "30px"
      },
      "2xl": {
        "value": "36px",
        "lineHeight": "40px"
      }
    },
    "weight": {
      "regular": 400,
      "medium": 500,
      "semibold": 600,
      "bold": 700
    },
    "tracking": {
      "tight": "-0.02em",
      "normal": "0",
      "wide": "0.08em"
    }
