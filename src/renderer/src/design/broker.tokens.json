{
  "$schema": "https://tradia.local/schemas/design-tokens.v1.json",
  "meta": {
    "name": "Tradia — Cuaderno cuantitativo · Broker paper",
    "version": "5.0.0",
    "extends": ["./base.tokens.json", "./risk.tokens.json"],
    "contrastStandard": "WCAG 2.2 AA",
    "baseUnit": "4px"
  },
  "color": {
    "paper": {
      "light": "#5B3B91",
      "lightSurface": "#EEE6FA",
      "dark": "#D0B4FF",
      "darkSurface": "#35244F",
      "label": "Solo paper · sin dinero real",
      "icon": "flask-conical"
    },
    "orderStatus": {
      "pending": { "light": "#765500", "lightSurface": "#FFF0BF", "dark": "#FFD166", "darkSurface": "#45320D", "label": "Pendiente", "icon": "clock-3" },
      "sent": { "light": "#1746C6", "lightSurface": "#E5EBFF", "dark": "#8EACFF", "darkSurface": "#1B3265", "label": "Enviada", "icon": "send" },
      "partial": { "light": "#765500", "lightSurface": "#FFF0BF", "dark": "#FFD166", "darkSurface": "#45320D", "label": "Ejecución parcial", "icon": "circle-dashed" },
      "filled": { "light": "#126B4B", "lightSurface": "#DDF3E9", "dark": "#65D6A4", "darkSurface": "#12382C", "label": "Ejecutada", "icon": "circle-check" },
      "cancelled": { "light": "#566174", "lightSurface": "#ECE9E1", "dark": "#B8C1CE", "darkSurface": "#2B384C", "label": "Cancelada", "icon": "circle-slash-2" },
      "rejected": { "light": "#A12232", "lightSurface": "#FBE4E7", "dark": "#FF8D9B", "darkSurface": "#4B1C26", "label": "Rechazada", "icon": "circle-x" },
      "orphaned": { "light": "#A33B18", "lightSurface": "#FCE7DC", "dark": "#FF9B73", "darkSurface": "#4A2419", "label": "Huérfana", "icon": "unlink" }
    },
    "reconciliation": {
      "matched": { "light": "#126B4B", "lightSurface": "#DDF3E9", "dark": "#65D6A4", "darkSurface": "#12382C", "label": "Sin diferencias", "icon": "equal" },
      "running": { "light": "#1746C6", "lightSurface": "#E5EBFF", "dark": "#8EACFF", "darkSurface": "#1B3265", "label": "Conciliando", "icon": "loader" },
      "mismatch": { "light": "#A12232", "lightSurface": "#FBE4E7", "dark": "#FF8D9B", "darkSurface": "#4B1C26", "label": "Descuadre", "icon": "triangle-alert" },
      "unknown": { "light": "#566174", "lightSurface": "#ECE9E1", "dark": "#B8C1CE", "darkSurface": "#2B384C", "label": "Sin comprobar", "icon": "circle-help" }
    },
    "deviation": {
      "within": { "light": "#126B4B", "lightSurface": "#DDF3E9", "dark": "#65D6A4", "darkSurface": "#12382C", "label": "Dentro del margen", "icon": "check" },
      "outside": { "light": "#A12232", "lightSurface": "#FBE4E7", "dark": "#FF8D9B", "darkSurface": "#4B1C26", "label": "Fuera de margen", "icon": "triangle-alert" }
    }
  },
  "typography": {
    "family": {
      "interface": { "value": "Inter, ui-sans-serif, -apple-system, BlinkMacSystemFont, 'Segoe UI', sans-serif", "name": "Interfaz" },
      "editorial": { "value": "Iowan Old Style, Charter, Georgia, serif", "name": "Editorial" },
      "numeric": { "value": "SFMono-Regular, Consolas, 'Liberation Mono', monospace", "name": "Datos" }
    },
    "numeric": { "fontVariantNumeric": "tabular-nums", "slashedZero": true },
    "size": {
      "xs": { "value": "12px", "lineHeight": "16px" },
      "sm": { "value": "14px", "lineHeight": "20px" },
      "md": { "value": "16px", "lineHeight": "24px" },
      "lg": { "value": "18px", "lineHeight": "26px" },
      "xl": { "value": "24px", "lineHeight": "32px" },
      "2xl": { "value": "34px", "lineHeight": "40px" }
    },
    "weight": { "regular": 400, "medium": 560, "semibold": 650, "bold": 740 },
    "tracking": { "tight": "-0.02em", "normal": "0", "wide": "0.04em" }
  },
  "spacing": { "0": "0", "1": "4px", "2": "8px", "3": "12px", "4": "16px", "5": "20px", "6": "24px", "8": "32px", "10": "40px", "12": "48px", "16": "64px" },
  "radius": { "xs": "4px", "sm": "8px", "md": "12px", "lg": "16px", "pill": "999px" },
  "shadow": {
    "raised": { "value": "0 10px 28px rgba(23, 35, 58, 0.10)", "name": "Elevado" },
    "floating": { "value": "0 18px 48px rgba(8, 18, 35, 0.18)", "name": "Flotante" }
  },
  "size": {
    "controlMin": "44px",
    "sidebar": "228px",
    "contentMax": "1440px",
    "statusBar": "48px",
    "ordersTableMin": "1180px",
    "deviationTableMin": "1040px",
    "dialogMax": "520px",
    "ocoRail": "2px"
  },
  "motion": { "fast": "120ms", "normal": "200ms", "slow": "320ms", "easeOut": "cubic-bezier(0.16, 1, 0.3, 1)", "reduced": "0ms" }
}
