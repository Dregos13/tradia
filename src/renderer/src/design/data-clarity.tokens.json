{
  "$schema": "https://tradia.local/schemas/design-tokens.v1.json",
  "meta": {
    "name": "Tradia — Claridad de datos y conectores",
    "version": "7.0.0",
    "extends": [
      "src/renderer/src/design/base.tokens.json",
      "src/renderer/src/design/market.tokens.json",
      "src/renderer/src/design/onboarding.tokens.json"
    ],
    "scope": "Solo tokens nuevos o cambiados para legibilidad, activos sin cobertura y conectores",
    "contrastStandard": "WCAG 2.2 AA",
    "contrastMethod": "Luminancia relativa sRGB (WCAG 2.2)",
    "baseUnit": "4px"
  },
  "color": {
    "light": {
      "canvas": "#EEF2F5",
      "surface": "#FFFFFF",
      "surfaceSubtle": "#E7ECF0",
      "sidebar": "#E3E9EE",
      "sidebarText": "#0C1218",
      "text": "#0C1218",
      "textMuted": "#475563",
      "accent": "#4A6500",
      "accentHover": "#3A5000",
      "inverse": "#FFFFFF",
      "focus": "#4A6500"
    },
    "dark": {
      "canvas": "#0A0E12",
      "surface": "#10161C",
      "surfaceSubtle": "#151C23",
      "sidebar": "#07090C",
      "sidebarText": "#E4EAF0",
      "text": "#E4EAF0",
      "textMuted": "#9AA8B6",
      "accent": "#C6F432",
      "accentHover": "#D7FB66",
      "inverse": "#0A0E12",
      "focus": "#C6F432"
    },
    "semantic": {
      "covered": {
        "label": "Al día",
        "light": "#0B7548",
        "lightSurface": "#DCF2E7",
        "dark": "#3CCB8A",
        "darkSurface": "#0E271D",
        "secondaryCue": "icono circle-check + texto"
      },
      "uncovered": {
        "label": "Sin cobertura",
        "light": "#7A5900",
        "lightSurface": "#F5ECCB",
        "dark": "#EBC05A",
        "darkSurface": "#2E2610",
        "secondaryCue": "icono circle-slash + texto; nunca tratar como caída del proveedor"
      },
      "partial": {
        "label": "Actualización parcial",
        "light": "#7A5900",
        "lightSurface": "#F5ECCB",
        "dark": "#EBC05A",
        "darkSurface": "#2E2610",
        "secondaryCue": "recuento actualizado/total + lista de excepciones"
      },
      "critical": {
        "label": "Necesita atención",
        "light": "#B0202E",
        "lightSurface": "#FBE3E5",
        "dark": "#FF7D87",
        "darkSurface": "#3A1519",
        "secondaryCue": "icono circle-alert + texto"
      },
      "offline": {
        "label": "Sin conexión",
        "light": "#A3460E",
        "lightSurface": "#FBE6D8",
        "dark": "#FF9A5C",
        "darkSurface": "#33200F",
        "secondaryCue": "icono wifi-off + texto"
      },
      "info": {
        "label": "Comprobando",
        "light": "#0A6390",
        "lightSurface": "#DDEFF8",
        "dark": "#6CC6F2",
        "darkSurface": "#0E2431",
        "secondaryCue": "icono loader + texto"
      }
    }
  },
