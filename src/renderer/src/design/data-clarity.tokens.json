  "typography": {
    "family": {
      "interface": "Sora, ui-sans-serif, -apple-system, BlinkMacSystemFont, 'Segoe UI', sans-serif",
      "editorial": "Sora, ui-sans-serif, -apple-system, BlinkMacSystemFont, 'Segoe UI', sans-serif",
      "numeric": "'IBM Plex Mono', ui-monospace, SFMono-Regular, Consolas, 'Liberation Mono', monospace"
    },
    "size": {
      "caption": {
        "value": "14px",
        "lineHeight": "21px",
        "use": "metadatos y ayudas; mínimo informativo"
      },
      "small": {
        "value": "14px",
        "lineHeight": "21px",
        "use": "texto secundario, insignias y etiquetas"
      },
      "body": {
        "value": "16px",
        "lineHeight": "24px",
        "use": "base de la aplicación y controles"
      },
      "titleSmall": {
        "value": "18px",
        "lineHeight": "26px",
        "use": "tarjetas y avisos"
      },
      "title": {
        "value": "24px",
        "lineHeight": "30px",
        "use": "título de pantalla"
      },
      "display": {
        "value": "36px",
        "lineHeight": "40px",
        "use": "encabezado principal cuando exista"
      }
    },
    "weight": {
      "regular": 400,
      "medium": 500,
      "semibold": 600,
      "bold": 700
    },
    "rule": "No usar 12px en información, estados, fechas ni acciones. 12px queda reservado a marcas decorativas sin contenido decisivo."
  },
  "spacing": {
    "inlineGap": "8px",
    "controlGap": "12px",
    "contentGap": "16px",
    "cardPadding": "20px",
    "sectionGap": "32px",
    "pagePaddingWide": "32px",
    "pagePaddingNarrow": "20px"
  },
  "radius": {
    "control": "8px",
    "card": "12px",
    "panel": "16px",
    "pill": "999px"
  },
  "shadow": {
    "floating": "0 16px 40px rgba(3, 5, 8, 0.32)"
  },
  "focus": {
    "width": "2px",
    "offset": "2px",
    "style": "solid",
    "token": "color.*.focus"
  },
  "size": {
    "controlMinHeight": "44px",
    "controlMinWidth": "44px",
    "copyMaxWidth": "70ch",
    "connectorCardMinWidth": "300px"
  },
  "motion": {
    "fast": "100ms",
    "normal": "160ms",
    "reduced": "0ms"
  }
}
