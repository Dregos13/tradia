      },
      "editorial": {
        "value": "Sora, ui-sans-serif, -apple-system, BlinkMacSystemFont, 'Segoe UI', sans-serif",
        "name": "Titulares · Sora"
      },
      "numeric": {
        "value": "'IBM Plex Mono', ui-monospace, SFMono-Regular, Consolas, 'Liberation Mono', monospace",
        "name": "Datos · IBM Plex Mono"
      }
    },
    "size": {
      "xs": {
        "value": "13px",
        "lineHeight": "18px",
        "name": "Metadato"
      },
      "sm": {
        "value": "14px",
        "lineHeight": "21px",
        "name": "Interfaz compacta"
      },
      "md": {
        "value": "16px",
        "lineHeight": "24px",
        "name": "Cuerpo"
      },
      "lg": {
        "value": "18px",
        "lineHeight": "26px",
        "name": "Título de bloque"
      },
      "xl": {
        "value": "24px",
        "lineHeight": "30px",
        "name": "Indicador"
      },
      "2xl": {
        "value": "36px",
        "lineHeight": "40px",
        "name": "Título de página"
      }
    },
    "weight": {
      "regular": 400,
      "medium": 500,
      "semibold": 600,
      "bold": 700
    },
    "tracking": {
      "tight": "-0.02em",
      "normal": "0",
      "wide": "0.08em"
    }
  },
  "spacing": {
    "0": "0",
    "1": "4px",
    "2": "8px",
    "3": "12px",
    "4": "16px",
    "5": "20px",
    "6": "24px",
    "8": "32px",
    "10": "40px",
    "12": "48px",
    "16": "64px"
  },
  "radius": {
    "xs": "2px",
    "sm": "4px",
    "md": "6px",
    "lg": "8px",
    "pill": "999px"
  },
  "shadow": {
    "raised": {
      "value": "0 1px 0 rgba(10, 14, 18, 0.06), 0 6px 16px rgba(10, 14, 18, 0.08)",
      "name": "Elevado (solo menús y popovers)"
    },
    "floating": {
      "value": "0 16px 40px rgba(3, 5, 8, 0.32)",
      "name": "Flotante (diálogos)"
    },
    "scrollEdge": {
      "value": "inset -12px 0 12px -14px rgba(10, 14, 18, 0.32)",
      "name": "Continuidad horizontal"
    }
  },
  "size": {
    "controlMin": "44px",
    "sidebar": "228px",
    "contentMax": "1120px",
    "statusBar": "48px",
    "dashboardGap": "16px",
    "panelMin": "280px",
    "journalTableMin": "1040px",
    "detailPanel": "420px",
    "dialogMax": "520px"
  },
  "layout": {
    "wide": {
      "breakpoint": "1100px",
      "columns": 12,
      "pagePadding": "32px"
    },
    "compact": {
      "breakpoint": "700px",
      "columns": 1,
      "pagePadding": "20px"
    },
    "dashboard": {
      "connection": "span 12",
      "macro": "span 12",
      "signals": "span 12",
      "positions": "span 12",
      "drawdown": "span 12",
      "exposure": "span 12",
      "strategies": "span 12"
    }
  },
  "motion": {
    "fast": "100ms",
    "normal": "160ms",
    "slow": "240ms",
    "easeOut": "cubic-bezier(0.2, 0.9, 0.1, 1)",
    "reduced": "0ms"
  }
