{
  "$schema": "https://tradia.local/schemas/design-tokens.v1.json",
  "meta": {
    "name": "Tradia — Cuaderno cuantitativo · Panel, diario y operaciones",
    "version": "4.0.0",
    "extends": ["./base.tokens.json", "./risk.tokens.json"],
    "contrastStandard": "WCAG 2.2 AA",
    "baseUnit": "4px"
  },
  "color": {
    "signal": {
      "approved": { "light": "#126B4B", "lightSurface": "#DDF3E9", "dark": "#65D6A4", "darkSurface": "#12382C", "name": "Señal aprobada", "symbol": "✓", "contrastLight": "5.59:1", "contrastDark": "7.19:1" },
      "vetoed": { "light": "#A12232", "lightSurface": "#FBE4E7", "dark": "#FF8D9B", "darkSurface": "#4B1C26", "name": "Señal vetada", "symbol": "×", "contrastLight": "6.22:1", "contrastDark": "6.39:1" },
      "conflict": { "light": "#765500", "lightSurface": "#F5EAC2", "dark": "#F4CB62", "darkSurface": "#3E3214", "name": "Contradicción", "symbol": "↔", "contrastLight": "6.32:1", "contrastDark": "8.61:1" },
      "informative": { "light": "#1746C6", "lightSurface": "#E5EBFF", "dark": "#8EACFF", "darkSurface": "#1B3265", "name": "Informativa", "symbol": "i", "contrastLight": "7.14:1", "contrastDark": "6.82:1" }
    },
    "strategy": {
      "active": { "light": "#126B4B", "lightSurface": "#DDF3E9", "dark": "#65D6A4", "darkSurface": "#12382C", "name": "Activa", "symbol": "●" },
      "paper": { "light": "#5B3B91", "lightSurface": "#EEE6FA", "dark": "#D0B4FF", "darkSurface": "#35244F", "name": "Paper", "symbol": "◇" },
      "degraded": { "light": "#765500", "lightSurface": "#F5EAC2", "dark": "#F4CB62", "darkSurface": "#3E3214", "name": "Degradada", "symbol": "△" },
      "paused": { "light": "#566174", "lightSurface": "#ECE9E1", "dark": "#B8C1CE", "darkSurface": "#1D293B", "name": "En pausa", "symbol": "Ⅱ" }
    },
    "chart": {
      "positive": { "light": "#126B4B", "dark": "#65D6A4", "name": "Positivo" },
      "negative": { "light": "#A12232", "dark": "#FF8D9B", "name": "Negativo" },
      "threshold": { "light": "#765500", "dark": "#F4CB62", "name": "Límite" },
      "grid": { "light": "#DCD8CE", "dark": "#2B384C", "name": "Rejilla" },
      "neutral": { "light": "#566174", "dark": "#B8C1CE", "name": "Neutral" }
    },
    "overlay": {
      "light": "rgba(23, 35, 58, 0.54)",
      "dark": "rgba(4, 9, 17, 0.72)",
      "name": "Velo de diálogo"
    }
  },
  "typography": {
    "family": {
      "interface": { "value": "Inter, ui-sans-serif, -apple-system, BlinkMacSystemFont, 'Segoe UI', sans-serif", "name": "Interfaz" },
      "editorial": { "value": "Iowan Old Style, Charter, Georgia, serif", "name": "Editorial" },
      "numeric": { "value": "SFMono-Regular, Consolas, 'Liberation Mono', monospace", "name": "Datos" }
    },
    "size": {
      "xs": { "value": "12px", "lineHeight": "16px", "name": "Metadato" },
      "sm": { "value": "14px", "lineHeight": "20px", "name": "Interfaz compacta" },
      "md": { "value": "16px", "lineHeight": "24px", "name": "Cuerpo" },
      "lg": { "value": "18px", "lineHeight": "26px", "name": "Título de bloque" },
      "xl": { "value": "24px", "lineHeight": "32px", "name": "Indicador" },
      "2xl": { "value": "34px", "lineHeight": "40px", "name": "Título de página" }
    },
    "weight": { "regular": 400, "medium": 560, "semibold": 650, "bold": 740 },
    "tracking": { "tight": "-0.02em", "normal": "0", "wide": "0.04em" }
  },
  "spacing": { "0": "0", "1": "4px", "2": "8px", "3": "12px", "4": "16px", "5": "20px", "6": "24px", "8": "32px", "10": "40px", "12": "48px", "16": "64px" },
  "radius": { "xs": "4px", "sm": "8px", "md": "12px", "lg": "16px", "pill": "999px" },
  "shadow": {
    "raised": { "value": "0 10px 28px rgba(23, 35, 58, 0.10)", "name": "Elevado" },
    "floating": { "value": "0 18px 48px rgba(8, 18, 35, 0.18)", "name": "Flotante" },
    "scrollEdge": { "value": "inset -12px 0 12px -14px rgba(23, 35, 58, 0.32)", "name": "Continuidad horizontal" }
  },
  "size": {
    "controlMin": "44px",
    "sidebar": "228px",
    "contentMax": "1440px",
    "statusBar": "48px",
    "dashboardGap": "16px",
    "panelMin": "280px",
    "journalTableMin": "1040px",
    "detailPanel": "420px",
    "dialogMax": "520px"
  },
  "layout": {
    "wide": { "breakpoint": "1100px", "columns": 12, "pagePadding": "32px" },
    "compact": { "breakpoint": "700px", "columns": 1, "pagePadding": "20px" },
    "dashboard": {
      "connection": "span 4",
      "macro": "span 8",
      "signals": "span 8",
      "positions": "span 4",
      "drawdown": "span 4",
      "exposure": "span 4",
      "strategies": "span 4"
    }
  },
  "motion": { "fast": "120ms", "normal": "200ms", "slow": "320ms", "easeOut": "cubic-bezier(0.16, 1, 0.3, 1)", "reduced": "0ms" }
}
